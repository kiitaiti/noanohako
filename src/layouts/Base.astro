---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { site } from '../data/site';

interface Props {
  title: string; // ページ固有タイトル（サイト名は自動付与）
  description: string;
  path: string; // 例: "/service/"
  ogType?: 'website' | 'article';
  ogImage?: string; // 絶対URL or サイト内パス
  jsonLd?: object | object[];
  noindex?: boolean;
  isHome?: boolean;
  breadcrumbs?: { name: string; path: string }[];
  publishedTime?: string;
  modifiedTime?: string;
}

const {
  title,
  description,
  path,
  ogType = 'website',
  ogImage = site.ogImage,
  jsonLd,
  noindex = false,
  isHome = false,
  breadcrumbs,
  publishedTime,
  modifiedTime,
} = Astro.props;

const siteUrl = Astro.site?.toString().replace(/\/$/, '') ?? site.url;
const canonical = `${siteUrl}${path}`;
const fullTitle = isHome
  ? `${site.fullName}｜町田駅 徒歩6分・相模原市南区`
  : `${title}｜${site.name}`;
const ogImageUrl = ogImage.startsWith('http') ? ogImage : `${siteUrl}${ogImage}`;
const envNoindex = import.meta.env.ASTRO_NOINDEX === 'true';
const robots = noindex || envNoindex ? 'noindex, nofollow' : 'index, follow, max-image-preview:large';
const gaId = import.meta.env.PUBLIC_GA_ID as string | undefined;

// 構造化データ
const orgId = `${siteUrl}/#organization`;
const facilityId = `${siteUrl}/#facility`;
const websiteId = `${siteUrl}/#website`;

const baseGraph: object[] = [
  {
    '@type': 'Organization',
    '@id': orgId,
    name: site.legalName,
    url: siteUrl,
    address: {
      '@type': 'PostalAddress',
      postalCode: '108-0075',
      addressRegion: '東京都',
      addressLocality: '港区',
      streetAddress: '港南3丁目5番16号',
      addressCountry: 'JP',
    },
  },
  {
    '@type': 'LocalBusiness',
    '@id': facilityId,
    name: site.fullName,
    alternateName: site.name,
    description: site.description,
    url: siteUrl,
    telephone: '+81-42-705-4422',
    email: site.email,
    image: ogImageUrl,
    parentOrganization: { '@id': orgId },
    address: {
      '@type': 'PostalAddress',
      postalCode: site.address.postal,
      addressRegion: site.address.region,
      addressLocality: site.address.locality,
      streetAddress: site.address.street,
      addressCountry: 'JP',
    },
    areaServed: ['相模原市', '町田市'],
    knowsAbout: ['就労継続支援B型', '動画編集', 'SNS運用', '3DCG', 'AI活用', 'カフェ業務'],
  },
  {
    '@type': 'Service',
    '@id': `${siteUrl}/#service`,
    name: '就労継続支援B型',
    serviceType: '就労継続支援B型（障害福祉サービス）',
    provider: { '@id': facilityId },
    areaServed: ['相模原市', '町田市'],
    description:
      'カフェまたはクリエイティブ（動画編集・SNS更新・3DCG・AI活用など）を中心とした作業を選べる就労継続支援B型。通所時間10:00〜15:00（休憩12:00〜13:00）、工賃 時給500円。',
    hoursAvailable: {
      '@type': 'OpeningHoursSpecification',
      opens: site.hours.open,
      closes: site.hours.close,
    },
  },
  {
    '@type': 'WebSite',
    '@id': websiteId,
    url: siteUrl,
    name: site.fullName,
    inLanguage: 'ja',
    publisher: { '@id': orgId },
  },
  {
    '@type': 'WebPage',
    '@id': `${canonical}#webpage`,
    url: canonical,
    name: fullTitle,
    description,
    isPartOf: { '@id': websiteId },
    about: { '@id': facilityId },
    inLanguage: 'ja',
    ...(modifiedTime ? { dateModified: modifiedTime } : {}),
  },
];

if (breadcrumbs && breadcrumbs.length) {
  baseGraph.push({
    '@type': 'BreadcrumbList',
    itemListElement: [{ name: 'ホーム', path: '/' }, ...breadcrumbs].map((b, i) => ({
      '@type': 'ListItem',
      position: i + 1,
      name: b.name,
      item: `${siteUrl}${b.path}`,
    })),
  });
}

const extra = jsonLd ? (Array.isArray(jsonLd) ? jsonLd : [jsonLd]) : [];
const graph = { '@context': 'https://schema.org', '@graph': [...baseGraph, ...extra] };
---

<!doctype html>
<html lang="ja" class="no-js">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta name="robots" content={robots} />
    <link rel="canonical" href={canonical} />
    <meta name="theme-color" content="#f7f6f2" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />

    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={site.fullName} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content="ja_JP" />
    {publishedTime && <meta property="article:published_time" content={publishedTime} />}
    {modifiedTime && <meta property="article:modified_time" content={modifiedTime} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Manrope:wght@600;700;800&family=Noto+Sans+JP:wght@400;500;700&display=swap"
    />
    <script is:inline>
      document.documentElement.classList.replace('no-js', 'js');
    </script>
    <script type="application/ld+json" set:html={JSON.stringify(graph)} />
    {
      gaId && (
        <>
          <script is:inline async src={`https://www.googletagmanager.com/gtag/js?id=${gaId}`} />
          <script is:inline define:vars={{ gaId }}>
            window.dataLayer = window.dataLayer || [];
            function gtag() {
              dataLayer.push(arguments);
            }
            gtag('js', new Date());
            gtag('config', gaId, { anonymize_ip: true });
          </script>
        </>
      )
    }
    {
      !gaId && (
        <script is:inline>
          // GA未設定時もイベント送信コードがエラーにならないようにする
          window.dataLayer = window.dataLayer || [];
        </script>
      )
    }
  </head>
  <body>
    <a class="skip-link" href="#main">本文へ移動</a>
    <Header />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <Footer />

    <script>
      import '../scripts/reveal.ts';
      import '../scripts/cursor.ts';
      import '../scripts/analytics.ts';
    </script>
  </body>
</html>

<style>
  .skip-link {
    position: absolute;
    left: 16px;
    top: -60px;
    z-index: 10000;
    background: var(--c-ink);
    color: #fff;
    padding: 10px 16px;
    border-radius: 6px;
    text-decoration: none;
    font-weight: 700;
  }
  .skip-link:focus {
    top: 12px;
  }
  main:focus {
    outline: none;
  }
</style>
