<script>
  // 導入演出（参考動画のタイムライン再現 / 初回表示のみ・1セッション1回）
  {
    const fv = document.querySelector<HTMLElement>('[data-intro]');
    const hero = document.querySelector<HTMLElement>('[data-hero]');
    const header = document.getElementById('site-header');
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    let seen = false;
    try { seen = sessionStorage.getItem('noanohako-intro') === '1'; } catch {}
    const q = (k: string) => document.querySelector<HTMLElement>(`[data-el="${k}"]`)!;

    if (fv && hero && !reduce && !seen) {
      hero.classList.add('is-intro');
      document.body.classList.add('is-intro');
      document.documentElement.style.overflow = 'hidden';
      const portrait = window.matchMedia('(max-aspect-ratio: 1/1)').matches;
      const BIG_START = portrait ? '70vh' : '78vh';
      const BIG_FINAL = portrait ? '10vh' : '8vh';
      hero.style.setProperty('--big-y', BIG_FINAL);
      const OUT = 'cubic-bezier(0.22, 1, 0.36, 1)';
      const INOUT = 'cubic-bezier(0.65, 0, 0.2, 1)';
      const SOFT = 'cubic-bezier(0.4, 0, 0.2, 1)';
      const el = {
        veil: q('veil'), plate: q('plate'), frame: q('frame'), frameImg: fv.querySelector<HTMLElement>('img')!,
        mark: q('mark'), big: q('big'), bigEcho: q('bigEcho'), content: q('content'), bottom: q('bottom'),
        header: header!, veilTail: fv,
      };
      // 写真が最終的に収まる位置＝ヒーローの実サイズ（ヘッダー下）。ここに一致させると切替時の段差が出ない
      const R = hero.getBoundingClientRect();
      const T: [keyof typeof el, Keyframe[], { at: number; dur: number; ease: string }][] = [
        ['veil', [{ opacity: 1 }, { opacity: 1, offset: 0.85 }, { opacity: 0 }], { at: 0, dur: 1.55, ease: 'linear' }],
        ['mark', [{ opacity: 0 }, { opacity: 1 }], { at: 0, dur: 0.18, ease: SOFT }],
        ['mark', [{ top: '47%' }, { top: '9%' }], { at: 0.12, dur: 0.5, ease: OUT }],
        ['mark', [{ opacity: 1 }, { opacity: 0 }], { at: 1.15, dur: 0.3, ease: SOFT }],
        ['plate', [{ opacity: 0 }, { opacity: 1 }], { at: 0.18, dur: 0.12, ease: 'linear' }],
        ['plate', [{ transform: 'scale(0.06) rotate(-22deg)' }, { transform: 'scale(0.55) rotate(-9deg)', offset: 0.35 }, { transform: 'scale(1) rotate(3deg)' }], { at: 0.18, dur: 0.42, ease: OUT }],
        ['plate', [{ transform: 'scale(1) rotate(3deg)' }, { transform: 'scale(1) rotate(0deg)' }], { at: 0.6, dur: 0.35, ease: SOFT }],
        ['plate', [{ transform: 'scale(1)', opacity: 1 }, { transform: portrait ? 'scale(1.6,2.2)' : 'scale(2,3.1)', opacity: 1, offset: 0.7 }, { transform: portrait ? 'scale(1.9,2.6)' : 'scale(2.4,3.4)', opacity: 0 }], { at: 1.0, dur: 0.5, ease: INOUT }],
        ['frame', [{ opacity: 0 }, { opacity: 1 }], { at: 0.1, dur: 0.1, ease: 'linear' }],
        ['frame', [{ width: portrait ? '5vw' : '2vw', height: portrait ? '5vw' : '2vw' }, { width: portrait ? '36vw' : '16vw', height: portrait ? '36vw' : '16vw' }], { at: 0.1, dur: 0.5, ease: OUT }],
        ['frame', [{ width: portrait ? '36vw' : '16vw', height: portrait ? '36vw' : '16vw' }, { width: portrait ? '42vw' : '19vw', height: portrait ? '42vw' : '19vw' }], { at: 0.6, dur: 0.4, ease: SOFT }],
        ['frame', [
          { left: '50%', top: '50%', transform: 'translate(-50%,-50%)', width: portrait ? '42vw' : '19vw', height: portrait ? '42vw' : '19vw', borderRadius: '0.55vw' },
          { left: '50%', top: '50%', transform: 'translate(-50%,-50%)', width: portrait ? '90vw' : '58vw', height: portrait ? '60vh' : '66vh', borderRadius: '0.4vw', offset: 0.45 },
          { left: '0px', top: `${R.top}px`, transform: 'translate(0,0)', width: `${R.width}px`, height: `${R.height}px`, borderRadius: '0' },
        ], { at: 1.0, dur: 0.45, ease: INOUT }],
        ['veilTail', [{ opacity: 1 }, { opacity: 0 }], { at: 1.45, dur: 0.4, ease: 'linear' }],
        ['frameImg', [{ transform: 'scale(1.35)' }, { transform: 'scale(1.35)', offset: 0.62 }, { transform: 'scale(1)' }], { at: 0.1, dur: 1.35, ease: INOUT }],
        ['big', [{ opacity: 0, transform: `translateY(${BIG_START})` }, { opacity: 0.08, transform: `translateY(${BIG_START})` }], { at: 0.3, dur: 0.25, ease: 'linear' }],
        ['big', [{ transform: `translateY(${BIG_START})`, opacity: 0.08 }, { transform: `translateY(${BIG_FINAL})`, opacity: 0.14 }], { at: 1.05, dur: 0.5, ease: INOUT }],
        ['bigEcho', [{ transform: `translateY(calc(${BIG_START} - 0.1em))`, opacity: 0 }, { transform: `translateY(calc(${BIG_FINAL} + 0.55em))`, opacity: 0.35, offset: 0.35 }, { transform: `translateY(calc(${BIG_FINAL} + 0.12em))`, opacity: 0.22, offset: 0.75 }, { transform: `translateY(${BIG_FINAL})`, opacity: 0 }], { at: 1.08, dur: 0.6, ease: INOUT }],
        ['header', [{ opacity: 0 }, { opacity: 1 }], { at: 1.45, dur: 0.35, ease: SOFT }],
        ['content', [{ opacity: 0, transform: 'translateY(12px)' }, { opacity: 1, transform: 'translateY(0)' }], { at: 1.7, dur: 0.45, ease: OUT }],
        ['bottom', [{ opacity: 0 }, { opacity: 1 }], { at: 1.9, dur: 0.4, ease: SOFT }],
      ];
      const TOTAL = 2.4;
      // 導入レイヤーは写真がヒーロー位置に収まった後、下の本体と同じ絵のまま透明化して消える
      const finish = () => {
        hero.classList.remove('is-intro');
        document.body.classList.remove('is-intro');
        fv.classList.add('is-done');
        document.documentElement.style.overflow = '';
      };
      const play = () => {
        // veil より上に置くため、導入中は fixed の fv がヘッダーも覆う
        T.forEach(([k, frames, o]) => el[k].animate(frames, { delay: o.at * 1000, duration: o.dur * 1000, easing: o.ease, fill: 'forwards' }));
        setTimeout(finish, TOTAL * 1000);
      };
      // 画像デコード完了を待つ（最大1.5秒）
      const imgs = [el.frameImg as HTMLImageElement, hero.querySelector<HTMLImageElement>('.hero__slide.is-active img')!].filter(Boolean);
      const ready = imgs.map((img) => (img.complete ? img.decode().catch(() => {}) : new Promise<void>((r) => { img.addEventListener('load', () => img.decode().then(() => r(), () => r()), { once: true }); img.addEventListener('error', () => r(), { once: true }); })));
      Promise.race([Promise.all(ready), new Promise((r) => setTimeout(r, 1500))]).then(() => requestAnimationFrame(() => requestAnimationFrame(play)));
      try { sessionStorage.setItem('noanohako-intro', '1'); } catch {}
    } else if (fv) {
      fv.classList.add('is-done');
    }
  }

</script>

<script>
  // 背景イラストの泡に合わせた、下から上へゆっくり昇る泡（クリーム色の輪郭／小さな塗り）
  const cv = document.querySelector<HTMLCanvasElement>('[data-bubbles]');
  const reduceB = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  if (cv && !reduceB) {
    const ctx = cv.getContext('2d')!;
    let W = 0, H = 0, dpr = Math.min(2, window.devicePixelRatio || 1);
    type B = { x: number; y: number; r: number; v: number; sway: number; ph: number; fill: boolean; a: number };
    const bs: B[] = [];
    const resize = () => {
      const rect = cv.getBoundingClientRect(); W = rect.width; H = rect.height;
      cv.width = W * dpr; cv.height = H * dpr; ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
    };
    resize(); window.addEventListener('resize', resize);
    const spawn = (y = H + 20): B => {
      const fill = Math.random() < 0.45;
      return { x: Math.random() * W, y, r: fill ? 1.5 + Math.random() * 2.5 : 4 + Math.random() * 10, v: 12 + Math.random() * 22, sway: 6 + Math.random() * 14, ph: Math.random() * Math.PI * 2, fill, a: 0.55 + Math.random() * 0.35 };
    };
    const N = Math.round(Math.min(46, W / 30));
    for (let i = 0; i < N; i++) bs.push(spawn(Math.random() * H));
    let last = performance.now();
    const cream = '238,232,214';
    const draw = (now: number) => {
      const dt = Math.min(0.05, (now - last) / 1000); last = now;
      ctx.clearRect(0, 0, W, H);
      for (const b of bs) {
        b.y -= b.v * dt; b.ph += dt * 1.2;
        const x = b.x + Math.sin(b.ph) * b.sway;
        const fade = Math.min(1, (b.y + b.r) / 80) * Math.min(1, (H - b.y) / 60);
        ctx.beginPath(); ctx.arc(x, b.y, b.r, 0, Math.PI * 2);
        if (b.fill) { ctx.fillStyle = `rgba(${cream},${b.a * fade})`; ctx.fill(); }
        else { ctx.lineWidth = 2; ctx.strokeStyle = `rgba(${cream},${b.a * fade})`; ctx.stroke(); }
        if (b.y < -b.r - 10) Object.assign(b, spawn());
      }
      requestAnimationFrame(draw);
    };
    requestAnimationFrame(draw);
  }
</script>
