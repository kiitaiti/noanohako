---
import Base from '../layouts/Base.astro';
import Photo from '../components/Photo.astro';
import KeyFacts from '../components/KeyFacts.astro';
import GrowthDiagram from '../components/GrowthDiagram.astro';
import Steps from '../components/Steps.astro';
import FaqList from '../components/FaqList.astro';
import CTASection from '../components/CTASection.astro';
import Logo from '../components/Logo.astro';
import FeaturedWorks from '../components/FeaturedWorks.astro';
import { site, faqs } from '../data/site';
import { getNews, formatDate, toISODate } from '../lib/cms';

import heroImg from '../assets/photos/hero-illust-wide.jpg';
import cafeImg from '../assets/photos/cafe-space-people.jpg';
import pcRowImg from '../assets/photos/pc-row.jpg';
import logoWallImg from '../assets/photos/main-floor-logo-wall.jpg';
import roomImg from '../assets/photos/private-room-3.jpg';
import pcCloseImg from '../assets/photos/pc-closeup.jpg';
import yellowImg from '../assets/photos/floor-hex-yellow.jpg';

const news = (await getNews()).slice(0, 3);
const topFaqs = faqs.slice(0, 5);

const description = site.description;
---

<Base title="ホーム" description={description} path="/" isHome ogImage="/og-image.jpg">
  <!-- ========== 1. ファーストビュー（フルスクリーン・スライドショー） ========== -->
  <!-- 導入演出（初回表示のみ / 参考動画のタイムラインを再現） -->
  <div class="fv" data-intro aria-hidden="true">
    <div class="fv__veil" data-el="veil"></div>
    <div class="fv__plate" data-el="plate"></div>
    <div class="fv__frame" data-el="frame">
      <Photo src={heroImg} alt="" sizes="100vw" widths={[1280, 1920]} eager class="fv__frame-img" />
    </div>
    <div class="fv__mark" data-el="mark"><Logo width={44} /></div>
  </div>

  <section class="hero" aria-labelledby="hero-title" data-hero>
    <div class="hero__stage" data-stage>
    <div class="hero__slides" data-slideshow aria-hidden="true">
      <div class="hero__slide is-active">
        <Photo
          src={heroImg}
          alt=""
          sizes="100vw"
          widths={[768, 1280, 1920, 2600]}
          eager
          class="hero__img"
        />
      </div>
    </div>
    <div class="hero__shade" aria-hidden="true"></div>
    <canvas class="hero__bubbles" data-bubbles aria-hidden="true"></canvas>
    </div>

    <div class="hero__big" aria-hidden="true">
      <span class="hero__big-echo" data-el="bigEcho">NOANO<wbr />HAKO</span>
      <span class="hero__big-text" data-el="big">NOANO<wbr />HAKO</span>
    </div>

    <div class="container hero__content" data-el="content">
      <p class="hero__eyebrow">
          <span>就労継続支援B型事業所</span>
          <span class="hero__eyebrow-sep" aria-hidden="true"></span>
          <span>神奈川県相模原市南区・町田駅 徒歩6分</span>
        </p>
      <h1 id="hero-title" class="hero__title">好きなことを、力に。</h1>
      <div class="hero__row">
      <div class="hero__main">
        <p class="hero__lead">
          カフェやクリエイティブの仕事を、自分に合ったペースで。<br class="pc-only" />
          のあのはこは、一人ひとりの「やってみたい」を支える就労継続支援B型事業所です。
        </p>
        <div class="hero__actions">
          <a href="/contact/" class="btn btn--primary" data-cta="hero_contact">
            見学・体験を相談する
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </a>
          <a href="/service/" class="btn btn--outline-light" data-cta="hero_service">作業内容を見る</a>
        </div>
      </div>

      </div>
    </div>

    <div class="hero__bottom container" aria-hidden="true" data-el="bottom">
      <p class="hero__scroll"><span>Scroll</span><i></i></p>
    </div>
  </section>

  <!-- ========== 1.5 制作実績（固定リスト） ========== -->
  <FeaturedWorks />

  <!-- ========== 2. 基本情報 ========== -->
  <section class="facts-section" aria-labelledby="facts-title">
    <div class="container">
      <h2 id="facts-title" class="visually-hidden">通所時間・休憩・工賃・作業の選び方</h2>
      <KeyFacts />
      <p class="facts-section__note">
        工賃は{site.wage.label}、{site.wage.monthlyMax}（{site.wage.monthlyNote}）。通所時間・休憩・工賃は作業の方向性にかかわらず共通です。
        <a href="/guide/" class="text-link">利用案内を見る
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </a>
      </p>
    </div>
  </section>

  <!-- ========== 3. のあのはことは ========== -->
  <section class="section about" aria-labelledby="about-title">
    <div class="container about__grid">
      <div class="about__head" data-reveal>
        <p class="eyebrow">About</p>
        <h2 id="about-title" class="h2">「はこ」のような、<br />あなたの居場所。</h2>
      </div>
      <div class="about__body" data-reveal style="--reveal-delay:.1s">
        <p class="lead">
          体調や障がいのことで、いきなり働くことに不安がある。そんな方が、自分のペースで取り組める場所でありたいと考えています。
        </p>
        <p>
          のあのはこは、神奈川県相模原市南区にある就労継続支援B型事業所です。「やってみたい」「できた」という小さな経験を、ひとつずつ積み重ねていく。好きなことや得意なことを入り口に、社会で活きる力と自信を育てていきます。
        </p>
        <ul class="about__values">
          <li>
            <strong>本人のペースを尊重する</strong>
            <span>できることから、少しずつ。無理のない範囲で取り組みます。</span>
          </li>
          <li>
            <strong>実際の設備で、実際の作業を</strong>
            <span>カフェ空間や制作用のパソコンなど、本物の環境で経験を重ねます。</span>
          </li>
          <li>
            <strong>「毎日来られる」を大切に</strong>
            <span>就労だけをゴールにせず、通える・言える・助け合えるという前進を大切にします。</span>
          </li>
        </ul>
        <a href="/service/#support" class="text-link">支援体制と施設について
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </a>
      </div>
    </div>
  </section>

  <!-- ========== 4. 選べる作業内容 ========== -->
  <section class="section section--white service" aria-labelledby="service-title">
    <div class="container">
      <div class="section-head section-head--split">
        <div data-reveal>
          <p class="eyebrow">Service</p>
          <h2 id="service-title" class="h2">興味や得意に合わせて、<br />作業の方向性を選べます。</h2>
        </div>
        <p class="lead" data-reveal style="--reveal-delay:.1s">
          カフェを中心とした作業か、クリエイティブを中心とした作業か。どちらを選んでも、通所時間は{site.hours.label}、工賃は{site.wage.label}で同じです。
        </p>
      </div>

      <div class="service__row service__row--cafe">
        <div class="service__photo" data-reveal>
          <Photo
            src={cafeImg}
            alt="カフェスペースのハイテーブルに座る3人。奥にカウンターと、飲み物やお菓子が並ぶ棚が見える"
            sizes="(min-width: 900px) 52vw, 100vw"
            widths={[640, 960, 1280, 1600]}
            aspect="4/3"
            position="50% 60%"
            class="service__img"
          />
        </div>
        <div class="service__text" data-reveal style="--reveal-delay:.1s">
          <p class="service__tag">カフェ中心</p>
          <h3 class="service__title">人と関わる仕事を、<br />カフェ空間で。</h3>
          <p>
            接客など、カフェ業務に関わる作業を中心に取り組みます。実際のカフェ空間で、お客さまとのやりとりや、仕事の段取りを経験できます。
          </p>
          <ul class="service__list">
            <li>接客</li>
            <li>カフェ業務に関わる作業</li>
          </ul>
        </div>
      </div>

      <div class="service__row service__row--creative">
        <div class="service__photo" data-reveal>
          <Photo
            src={pcRowImg}
            alt="制作用のパソコンが並ぶ作業席。各席にモニター、キーボード、ヘッドセットが用意されている"
            sizes="(min-width: 900px) 52vw, 100vw"
            widths={[640, 960, 1280, 1600]}
            aspect="4/3"
            position="50% 45%"
            class="service__img"
          />
        </div>
        <div class="service__text" data-reveal style="--reveal-delay:.1s">
          <p class="service__tag service__tag--creative">クリエイティブ中心</p>
          <h3 class="service__title">パソコンでつくる仕事を、<br />制作環境で。</h3>
          <p>
            動画編集、SNS更新、3DCG、AI活用など、制作やパソコンを使う作業を中心に取り組みます。実際の設備を使いながら、「できた」を積み重ねます。
          </p>
          <ul class="service__list">
            <li>動画編集</li>
            <li>SNS更新</li>
            <li>3DCG</li>
            <li>AI活用</li>
          </ul>
        </div>
      </div>

      <div class="service__other" data-reveal>
        <div>
          <h3 class="h3">そのほかの作業</h3>
          <p>データ入力、清掃業務、内職など、事業所内のさまざまな作業もあります。体調やその日の状況に合わせて、スタッフと相談しながら取り組みます。</p>
        </div>
        <a href="/service/" class="btn btn--ghost" data-cta="top_service">作業内容をくわしく見る</a>
      </div>
    </div>
  </section>

  <!-- ========== 5. 成長を支える3つの要素 ========== -->
  <section class="section growth-section" aria-labelledby="growth-title">
    <div class="container growth-section__grid">
      <div class="growth-section__figure" data-reveal>
        <GrowthDiagram />
      </div>
      <div class="growth-section__text">
        <p class="eyebrow" data-reveal>Growth</p>
        <h2 id="growth-title" class="h2" data-reveal>成長を支える、3つの要素。</h2>
        <p class="lead" data-reveal style="--reveal-delay:.05s">
          好きなことを入り口にしながら、社会で活きる力を少しずつ育てます。取り組む内容や進み方は、一人ひとり異なります。
        </p>
        <dl class="growth-list">
          <div data-reveal style="--reveal-delay:.1s">
            <dt><span class="growth-list__num">1</span>社会性</dt>
            <dd>思いやり、コミュニケーション、協調性、自己理解など。人と関わるなかで育つ力です。</dd>
          </div>
          <div data-reveal style="--reveal-delay:.15s">
            <dt><span class="growth-list__num">2</span>仕事の流れ</dt>
            <dd>仕事の進め方、役割、受注から納品までの流れなど。「仕事」の全体像を経験します。</dd>
          </div>
          <div data-reveal style="--reveal-delay:.2s">
            <dt><span class="growth-list__num">3</span>スキル</dt>
            <dd>動画編集や制作、実際の設備を使った作業など。手を動かして身につける力です。</dd>
          </div>
        </dl>
      </div>
    </div>
  </section>

  <!-- ========== 6. 支援体制 ========== -->
  <section class="section section--tint support" aria-labelledby="support-title">
    <div class="container">
      <div class="section-head" data-reveal>
        <p class="eyebrow">Support</p>
        <h2 id="support-title" class="h2">一人ひとりに合わせた支援。</h2>
      </div>
      <div class="support__grid">
        <article class="support__item" data-reveal>
          <h3>個別支援計画</h3>
          <p>ご本人の希望や状況をもとに計画を作成し、目標や取り組みを一緒に確認しながら進めます。</p>
        </article>
        <article class="support__item" data-reveal style="--reveal-delay:.06s">
          <h3>健康・生活リズムのサポート</h3>
          <p>通所を続けるための体調や生活リズムを、無理のない形で一緒に整えていきます。</p>
        </article>
        <article class="support__item" data-reveal style="--reveal-delay:.12s">
          <h3>対人・就労スキルの育成</h3>
          <p>あいさつや報告、役割分担など、働くうえで役立つ力を日々の活動のなかで育てます。</p>
        </article>
        <article class="support__item" data-reveal style="--reveal-delay:.18s">
          <h3>作品・実績づくりの支援</h3>
          <p>制作物や作業の経験を形に残し、次の一歩につながる実績づくりをサポートします。</p>
        </article>
      </div>
      <p class="support__note">スタッフ体制や資格の詳細については、見学・相談の際にご案内します。</p>
    </div>
  </section>

  <!-- ========== 7. 施設・設備 ========== -->
  <section class="section facility" aria-labelledby="facility-title">
    <div class="container">
      <div class="section-head section-head--split">
        <div data-reveal>
          <p class="eyebrow">Facility</p>
          <h2 id="facility-title" class="h2">実際の空間と設備。</h2>
        </div>
        <p class="lead" data-reveal style="--reveal-delay:.1s">
          制作用のパソコン、カフェ設備、少人数で使える個室など。同じ運営法人のeスポーツ施設「NOABOX」と連携した環境で活動しています。
        </p>
      </div>
      <div class="facility__gallery">
        <figure class="facility__fig facility__fig--l" data-reveal>
          <Photo src={logoWallImg} alt="メインフロア。壁面のロゴ、六角形の照明、並んだパソコン席" sizes="(min-width: 900px) 60vw, 100vw" widths={[640, 960, 1280, 1600]} aspect="3/2" class="facility__img" />
          <figcaption>メインフロア</figcaption>
        </figure>
        <figure class="facility__fig" data-reveal style="--reveal-delay:.08s">
          <Photo src={roomImg} alt="3人用の個室。3台のパソコンとモニターが並ぶ" sizes="(min-width: 900px) 38vw, 100vw" widths={[480, 768, 1024]} aspect="1/1" class="facility__img" />
          <figcaption>3人用個室</figcaption>
        </figure>
        <figure class="facility__fig facility__fig--l" data-reveal style="--reveal-delay:.16s">
          <Photo src={yellowImg} alt="観葉植物のあるフロア。木目のデスクにパソコンとモニターが並ぶ" sizes="(min-width: 900px) 60vw, 100vw" widths={[640, 960, 1280, 1600]} aspect="3/2" position="50% 55%" class="facility__img" />
          <figcaption>作業席とフロア</figcaption>
        </figure>
        <figure class="facility__fig" data-reveal style="--reveal-delay:.12s">
          <Photo src={pcCloseImg} alt="作業席に設置されたパソコン本体のアップ" sizes="(min-width: 900px) 38vw, 100vw" widths={[480, 768, 1024]} aspect="1/1" position="50% 40%" class="facility__img" />
          <figcaption>制作用パソコン</figcaption>
        </figure>
      </div>
      <a href="/service/#facility" class="text-link" data-reveal>施設・設備をくわしく見る
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" stroke-linecap="round" stroke-linejoin="round"/></svg>
      </a>
    </div>
  </section>

  <!-- ========== 8. 1日の流れ ========== -->
  <section class="section section--white day" aria-labelledby="day-title">
    <div class="container day__grid">
      <div class="day__head" data-reveal>
        <p class="eyebrow">Daily</p>
        <h2 id="day-title" class="h2">1日の流れ</h2>
        <p class="lead">通所時間は{site.hours.label}。{site.hours.breakLabel}は昼休憩です。作業の内容は、その日の体調や取り組みに合わせて調整します。</p>
      </div>
      <ol class="timeline">
        <li class="timeline__item" data-reveal>
          <time datetime="10:00">10:00</time>
          <div>
            <h3>通所・午前の活動</h3>
            <p>体調の確認をして、その日の作業を始めます。カフェ中心・クリエイティブ中心、それぞれの作業に取り組みます。</p>
          </div>
        </li>
        <li class="timeline__item" data-reveal style="--reveal-delay:.06s">
          <time datetime="12:00">12:00</time>
          <div>
            <h3>昼休憩（12:00〜13:00）</h3>
            <p>1時間の休憩です。昼食の提供はありませんので、各自でご用意ください。</p>
          </div>
        </li>
        <li class="timeline__item" data-reveal style="--reveal-delay:.12s">
          <time datetime="13:00">13:00</time>
          <div>
            <h3>午後の活動</h3>
            <p>午前の続きや、別の作業に取り組みます。分からないことはスタッフに相談しながら進めます。</p>
          </div>
        </li>
        <li class="timeline__item" data-reveal style="--reveal-delay:.18s">
          <time datetime="15:00">15:00</time>
          <div>
            <h3>活動終了・帰宅</h3>
            <p>片付けと振り返りをして、1日の活動を終えます。</p>
          </div>
        </li>
      </ol>
    </div>
  </section>

  <!-- ========== 9. 利用開始までの流れ ========== -->
  <section class="section flow" aria-labelledby="flow-title">
    <div class="container">
      <div class="section-head" data-reveal>
        <p class="eyebrow">Flow</p>
        <h2 id="flow-title" class="h2">利用開始までの流れ</h2>
      </div>
      <Steps />
    </div>
  </section>

  <!-- ========== 10. FAQ ========== -->
  <section class="section section--soft faq-section" aria-labelledby="faq-title">
    <div class="container faq-section__grid">
      <div class="faq-section__head" data-reveal>
        <p class="eyebrow">FAQ</p>
        <h2 id="faq-title" class="h2">よくある質問</h2>
        <p class="lead">工賃や通所時間、見学についてなど、よくいただくご質問をまとめました。</p>
        <a href="/faq/" class="btn btn--ghost btn--sm">すべての質問を見る</a>
      </div>
      <div>
        <FaqList items={topFaqs} />
      </div>
    </div>
  </section>

  <!-- ========== 11. お知らせ ========== -->
  <section class="section news-section" aria-labelledby="news-title">
    <div class="container">
      <div class="section-head section-head--split">
        <div data-reveal>
          <p class="eyebrow">Column</p>
          <h2 id="news-title" class="h2">コラム</h2>
        </div>
        <div class="news-section__links" data-reveal>
          <a href="/column/" class="text-link">コラム一覧
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </a>
          <a href="/works/" class="text-link">制作実績
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </a>
        </div>
      </div>
      <ul class="news-list">
        {
          news.map((n, i) => (
            <li class="news-list__item" data-reveal style={`--reveal-delay:${i * 0.06}s`}>
              <a href={`/column/${n.slug}/`}>
                <time datetime={toISODate(n.publishedAt)}>{formatDate(n.publishedAt)}</time>
                <span class="news-list__cat">{n.category}</span>
                <span class="news-list__title">{n.title}</span>
              </a>
            </li>
          ))
        }
        {news.length === 0 && <li class="news-list__empty">コラムは準備中です。</li>}
      </ul>
    </div>
  </section>

  <!-- ========== 12. アクセス・施設概要 ========== -->
  <section class="section section--white access" aria-labelledby="access-title">
    <div class="container access__grid">
      <div data-reveal>
        <p class="eyebrow">Access</p>
        <h2 id="access-title" class="h2">アクセス・施設概要</h2>
        <table class="table access__table">
          <tbody>
            <tr><th>施設名</th><td>{site.fullName}</td></tr>
            <tr><th>サービス種別</th><td>就労継続支援B型（障害福祉サービス）</td></tr>
            <tr><th>所在地</th><td>{site.address.full}</td></tr>
            <tr><th>最寄り駅</th><td>{site.nearestStation} {site.walk}</td></tr>
            <tr><th>電話</th><td><a href={site.telHref} data-location="top_access">{site.tel}</a>（受付 {site.receptionHours}）</td></tr>
            <tr><th>通所時間</th><td>{site.hours.label}（休憩 {site.hours.breakLabel}）</td></tr>
            <tr><th>運営法人</th><td>{site.legalName}</td></tr>
          </tbody>
        </table>
        <a href="/access/" class="text-link">地図と行き方を見る
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </a>
      </div>
      <div class="access__map" data-reveal style="--reveal-delay:.1s">
        <iframe
          title="のあのはこ 周辺地図（Googleマップ）"
